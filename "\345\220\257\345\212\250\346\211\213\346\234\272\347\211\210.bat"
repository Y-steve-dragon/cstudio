@echo off
chcp 65001 >nul
setlocal
cd /d "%~dp0"

where node >nul 2>nul
if errorlevel 1 (
  echo [!] 没有找到 Node.js。请先安装 Node.js 18+ 再运行本脚本。
  echo     下载: https://nodejs.org/
  pause
  exit /b 1
)

echo ============================================================
echo   掌心 C - 手机 C 语言 IDE
echo   正在启动本地服务器...
echo ============================================================
echo.
node serve.mjs %1
echo.
echo 服务器已停止。
pause
