/* 掌心 C · 界面样式（移动优先，深/浅/暗夜三套主题） */
:root {
  --fs: 14px;
  --lh: 22px;
  --tab: 4;
  --radius: 10px;
  --mono: ui-monospace, "SF Mono", "Cascadia Mono", "JetBrains Mono", Menlo, Consolas, "Noto Sans Mono CJK SC", monospace;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
}

/* ── 深色（默认） ── */
:root, [data-theme="dark"] {
  color-scheme: dark;
  --bg: #11161c;
  --bg-2: #161d25;
  --bg-3: #1d2530;
  --bg-4: #253040;
  --fg: #d7e0ea;
  --fg-dim: #8b98a8;
  --fg-faint: #5d6a79;
  --line: #26303c;
  --accent: #35b8ff;
  --accent-2: #0d84c8;
  --accent-fg: #04121c;
  --divider: #20293a;
  --ok: #46c98b;
  --warn: #e2b33c;
  --err: #f2707a;
  --sel: #2a4a63;
  --cur-line: rgba(120, 180, 255, .07);
  --gutter-fg: #4c5a6b;
  --t-kw: #c792ea;
  --t-ty: #82aaff;
  --t-fn: #ffcb6b;
  --t-num: #f78c6c;
  --t-str: #c3e88d;
  --t-chr: #c3e88d;
  --t-com: #5f7387;
  --t-pp: #89ddff;
  --shadow: 0 12px 32px rgba(0, 0, 0, .45);
}

/* ── 浅色 ── */
[data-theme="light"] {
  color-scheme: light;
  --bg: #f7f9fc;
  --bg-2: #ffffff;
  --bg-3: #eef2f7;
  --bg-4: #e2e8f0;
  --fg: #1d2733;
  --fg-dim: #5b6878;
  --fg-faint: #8d9aab;
  --line: #dbe3ec;
  --accent: #0d84c8;
  --accent-2: #0a6ba3;
  --accent-fg: #ffffff;
  --divider: #e6ecf3;
  --ok: #12885a;
  --warn: #a2700a;
  --err: #c93b47;
  --sel: #cfe6f7;
  --cur-line: rgba(13, 132, 200, .07);
  --gutter-fg: #9aa7b6;
  --t-kw: #8b3fb8;
  --t-ty: #0a58b8;
  --t-fn: #9a6300;
  --t-num: #b4451f;
  --t-str: #1f7a3d;
  --t-chr: #1f7a3d;
  --t-com: #7f8c9b;
  --t-pp: #0d6f7a;
  --shadow: 0 12px 28px rgba(30, 50, 80, .18);
}

/* ── 暗夜蓝 ── */
[data-theme="midnight"] {
  color-scheme: dark;
  --bg: #0b1220;
  --bg-2: #111b2d;
  --bg-3: #17233a;
  --bg-4: #1e2f4b;
  --fg: #cbd8ea;
  --fg-dim: #7e8ea8;
  --fg-faint: #55647c;
  --line: #1d2b44;
  --accent: #6ea8ff;
  --accent-2: #3f7fe0;
  --accent-fg: #050b16;
  --divider: #18253c;
  --ok: #43d39e;
  --warn: #e8c15a;
  --err: #ff7b8a;
  --sel: #24405f;
  --cur-line: rgba(110, 168, 255, .08);
  --gutter-fg: #46566e;
  --t-kw: #b48cf2;
  --t-ty: #7cb7ff;
  --t-fn: #ffd479;
  --t-num: #ff9d6b;
  --t-str: #9ee493;
  --t-chr: #9ee493;
  --t-com: #556a87;
  --t-pp: #79d7ef;
  --shadow: 0 14px 36px rgba(2, 8, 20, .6);
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

/* hidden 属性必须压过各组件自己的 display（否则查找栏、调试条、弹窗一上来就显示） */
[hidden] { display: none !important; }

html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  color: var(--fg);
  font-family: var(--sans);
  font-size: 14px;
  -webkit-text-size-adjust: 100%;
  overscroll-behavior: none;
}

body {
  display: flex;
  flex-direction: column;
  padding: env(safe-area-inset-top) 0 0 0;
  height: 100dvh;
}

button { font-family: inherit; font-size: inherit; color: inherit; }

/* ── 顶栏 ── */
.topbar {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 50px;
  padding: 0 8px;
  background: var(--bg-2);
  border-bottom: 1px solid var(--line);
  flex: 0 0 auto;
  z-index: 20;
}
.brand { display: flex; align-items: center; gap: 8px; min-width: 0; flex: 1; }
.logo {
  width: 26px; height: 26px; border-radius: 7px;
  background: linear-gradient(145deg, var(--accent), var(--accent-2));
  color: var(--accent-fg);
  display: grid; place-items: center;
  font-weight: 800; font-size: 15px;
  flex: 0 0 auto;
  box-shadow: 0 2px 8px rgba(0, 0, 0, .25);
}
.fname {
  font-family: var(--mono);
  font-size: 13px;
  color: var(--fg-dim);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.actions { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; }

.icon-btn {
  width: 38px; height: 38px;
  border: 1px solid transparent;
  background: transparent;
  border-radius: 9px;
  font-size: 17px;
  display: grid; place-items: center;
  cursor: pointer;
}
.icon-btn:active { background: var(--bg-3); }

.btn {
  display: inline-flex; align-items: center; gap: 5px;
  height: 36px; padding: 0 12px;
  border-radius: 9px;
  border: 1px solid var(--line);
  background: var(--bg-3);
  cursor: pointer;
  font-size: 13px;
  white-space: nowrap;
}
.btn:active { transform: translateY(1px); }
.btn.primary {
  background: linear-gradient(160deg, var(--accent), var(--accent-2));
  border-color: transparent;
  color: var(--accent-fg);
  font-weight: 700;
}
.btn.danger { background: var(--err); border-color: transparent; color: #fff; font-weight: 700; }
.btn:disabled { opacity: .45; }
.btn .ico { font-size: 12px; }
@media (max-width: 420px) {
  .btn .lbl { display: none; }
  .btn { padding: 0 10px; }
}

/* ── 主体 ── */
#main { flex: 1 1 auto; display: flex; min-height: 0; position: relative; }

.sidebar {
  width: 260px;
  flex: 0 0 auto;
  background: var(--bg-2);
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  padding-bottom: 12px;
}
@media (max-width: 820px) {
  .sidebar {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 30;
    transform: translateX(-104%);
    transition: transform .22s ease;
    box-shadow: var(--shadow);
    width: min(80vw, 320px);
  }
  .sidebar.open { transform: translateX(0); }
}
.side-section { padding: 10px 10px 4px; }
.side-head {
  display: flex; align-items: center; justify-content: space-between;
  font-size: 12px; color: var(--fg-faint); letter-spacing: .04em;
  margin-bottom: 6px; text-transform: uppercase;
}
.side-btns { display: flex; gap: 4px; }
.mini {
  min-width: 30px; height: 30px; padding: 0 8px;
  border-radius: 8px;
  border: 1px solid var(--line);
  background: var(--bg-3);
  color: var(--fg-dim);
  cursor: pointer;
  font-size: 13px;
}
.mini:active { background: var(--bg-4); }
.mini.primary { background: var(--accent); color: var(--accent-fg); border-color: transparent; font-weight: 700; }
.mini.danger { background: var(--err); color: #fff; border-color: transparent; }
.mini.wide { width: 100%; }

.file-list, .sample-list { list-style: none; margin: 0; padding: 0; }
.file-row {
  display: flex; align-items: center; gap: 6px;
  padding: 7px 6px;
  border-radius: 8px;
  cursor: pointer;
  font-family: var(--mono);
  font-size: 13px;
}
.file-row:active { background: var(--bg-3); }
.file-row.active { background: var(--bg-3); box-shadow: inset 2px 0 0 var(--accent); }
.f-ico { font-size: 12px; flex: 0 0 auto; }
.f-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.badge {
  font-family: var(--sans); font-size: 10px;
  background: var(--accent); color: var(--accent-fg);
  border-radius: 4px; padding: 1px 5px; font-weight: 700;
}
.bp-count {
  font-family: var(--sans); font-size: 10px;
  background: var(--err); color: #fff;
  border-radius: 8px; padding: 1px 5px;
}
.more { min-width: 26px; height: 26px; padding: 0; border-color: transparent; background: transparent; }

.sample-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8px 8px; border-radius: 8px; cursor: pointer; font-size: 13px;
}
.sample-row:active { background: var(--bg-3); }
.s-file { font-family: var(--mono); font-size: 11px; color: var(--fg-faint); }

.settings { display: flex; flex-direction: column; gap: 2px; }
.row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 6px 4px; font-size: 13px; color: var(--fg-dim);
}
.row select {
  background: var(--bg-3); color: var(--fg);
  border: 1px solid var(--line); border-radius: 7px;
  padding: 4px 6px; font-size: 13px;
}
.row input[type="checkbox"] {
  width: 38px; height: 22px; appearance: none;
  background: var(--bg-4); border-radius: 12px; position: relative; transition: background .15s;
}
.row input[type="checkbox"]::after {
  content: ''; position: absolute; top: 2px; left: 2px;
  width: 18px; height: 18px; border-radius: 50%; background: var(--fg-dim);
  transition: transform .15s, background .15s;
}
.row input[type="checkbox"]:checked { background: var(--accent); }
.row input[type="checkbox"]:checked::after { transform: translateX(16px); background: #fff; }
.stepper { display: flex; align-items: center; gap: 6px; }
.stepper b { font-family: var(--mono); min-width: 22px; text-align: center; color: var(--fg); }
.row.btns { padding-top: 10px; }

.side-foot { margin-top: auto; padding: 12px 12px 0; }
.hint { font-size: 11px; color: var(--fg-faint); line-height: 1.6; }

/* ── 工作区 ── */
.workspace { flex: 1 1 auto; display: flex; flex-direction: column; min-width: 0; min-height: 0; background: var(--bg); }

.tabs {
  display: flex; gap: 2px; overflow-x: auto; overflow-y: hidden;
  background: var(--bg-2); border-bottom: 1px solid var(--line);
  padding: 4px 6px 0; flex: 0 0 auto;
  scrollbar-width: none;
}
.tabs::-webkit-scrollbar { display: none; }
.tab {
  display: inline-flex; align-items: center; gap: 6px;
  border: 1px solid transparent; border-bottom: none;
  background: transparent; color: var(--fg-dim);
  padding: 6px 10px; border-radius: 8px 8px 0 0;
  font-family: var(--mono); font-size: 12px; white-space: nowrap; cursor: pointer;
}
.tab.active { background: var(--bg); color: var(--fg); border-color: var(--line); }
.tab .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--err); display: block; }

/* ── 编辑器 ── */
.editor {
  --lh: 22px;
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  position: relative;
  overflow: hidden;
  font-size: var(--fs);
}
.ed-gutter {
  width: 46px; flex: 0 0 auto;
  position: relative; overflow: hidden;
  background: var(--bg);
  border-right: 1px solid var(--divider);
  user-select: none;
}
.no-gutter .ed-gutter { display: none; }
.ed-bp, .ed-lines {
  position: absolute; top: 0; left: 0; right: 0;
  font-family: var(--mono); font-size: 12px; line-height: var(--lh);
  will-change: transform;
}
.ed-lines { padding-top: 8px; }
.ln {
  height: var(--lh); line-height: var(--lh);
  text-align: right; padding-right: 8px;
  color: var(--gutter-fg); cursor: pointer;
}
.ln.is-paused { color: var(--accent); font-weight: 700; background: rgba(53, 184, 255, .12); }
.ln.is-error { color: var(--err); }
.bp {
  position: absolute; left: 4px; width: 10px;
  font-size: 10px; line-height: var(--lh); text-align: center;
  color: var(--err);
}
.bp.cur { color: var(--accent); }

.ed-body { position: relative; flex: 1 1 auto; overflow: hidden; min-width: 0; }
.ed-hl, .ed-ta {
  font-family: var(--mono);
  font-size: var(--fs);
  line-height: var(--lh);
  tab-size: var(--tab);
  -moz-tab-size: var(--tab);
  margin: 0;
  padding: 8px 14px 40vh 12px;
  border: 0;
  white-space: pre;
  word-wrap: normal;
  overflow-wrap: normal;
}
.ed-hl {
  position: absolute; top: 0; left: 0;
  width: max-content; min-width: 100%;
  pointer-events: none;
  color: var(--fg);
  will-change: transform;
}
.ed-hl code { font: inherit; }
.ed-ta {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  resize: none; outline: none;
  background: transparent;
  color: transparent;
  caret-color: var(--accent);
  overflow: auto;
  -webkit-text-fill-color: transparent;
  z-index: 2;
}
.ed-ta::selection { background: var(--sel); -webkit-text-fill-color: transparent; }
/* 编辑器自己的滚动条也跟主题走，否则暗色界面上会冒出一条亮灰条 */
.ed-ta { scrollbar-width: thin; scrollbar-color: var(--bg-4) transparent; }
.ed-ta::-webkit-scrollbar { width: 7px; height: 7px; }
.ed-ta::-webkit-scrollbar-thumb { background: var(--bg-4); border-radius: 4px; }
.ed-ta::-webkit-scrollbar-track { background: transparent; }
.ed-ta::-webkit-scrollbar-corner { background: transparent; }
.wrap .ed-hl, .wrap .ed-ta { white-space: pre-wrap; word-break: break-word; }
.ed-current {
  position: absolute; left: 0; right: 0; top: 8px;
  height: var(--lh);
  background: var(--cur-line);
  pointer-events: none;
  display: none;
  z-index: 1;
}

/* 语法着色 */
.t-kw { color: var(--t-kw); }
.t-ty { color: var(--t-ty); }
.t-fn { color: var(--t-fn); }
.t-num { color: var(--t-num); }
.t-str { color: var(--t-str); }
.t-chr { color: var(--t-chr); }
.t-com { color: var(--t-com); font-style: italic; }
.t-pp { color: var(--t-pp); }

/* ── 查找栏 ── */
.findbar {
  display: flex; gap: 4px; align-items: center;
  padding: 6px 8px; background: var(--bg-2);
  border-top: 1px solid var(--line);
  flex: 0 0 auto;
}
.findbar input {
  flex: 1 1 0; min-width: 0;
  background: var(--bg-3); color: var(--fg);
  border: 1px solid var(--line); border-radius: 8px;
  padding: 7px 9px; font-family: var(--mono); font-size: 13px;
}
.findbar input:focus { outline: 1px solid var(--accent); }

/* ── 符号栏（可折叠 + 可左右滚动）── */
.symbar-wrap {
  flex: 0 0 auto;
  border-top: 1px solid var(--line);
  background: var(--bg-2);
}
.symbar-wrap[hidden] { display: none !important; }

.symbar-head {
  display: flex; align-items: center; gap: 6px;
  padding: 3px 8px 2px;
  font: 11px/1.4 var(--sans); color: var(--fg-faint);
  user-select: none;
}
.symbar-title { color: var(--fg-dim); font-weight: 600; letter-spacing: .04em; }
.symbar-hint { flex: 1 1 auto; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.symnav, .symbar-fold {
  flex: 0 0 auto;
  height: 22px; padding: 0 8px;
  border-radius: 6px; border: 1px solid var(--line);
  background: var(--bg-3); color: var(--fg-dim);
  font: 12px/1 var(--sans); cursor: pointer;
}
.symnav { width: 26px; padding: 0; font-size: 15px; line-height: 20px; }
.symnav:active, .symbar-fold:active { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
.symnav[disabled] { opacity: .35; }
.symbar-fold { min-width: 56px; }

.symbar {
  display: flex; gap: 4px;
  overflow-x: auto; overflow-y: hidden;
  padding: 2px 8px calc(6px + env(safe-area-inset-bottom));
  overscroll-behavior-x: contain;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
  scrollbar-color: var(--bg-4) transparent;
  /* 两端渐隐，提示"后面还有" */
  -webkit-mask-image: linear-gradient(to right, transparent 0, #000 10px, #000 calc(100% - 10px), transparent 100%);
  mask-image: linear-gradient(to right, transparent 0, #000 10px, #000 calc(100% - 10px), transparent 100%);
}
.symbar::-webkit-scrollbar { height: 4px; }
.symbar::-webkit-scrollbar-thumb { background: var(--bg-4); border-radius: 2px; }
.symbar::-webkit-scrollbar-track { background: transparent; }
.symbar-wrap[data-open="0"] .symbar { display: none; }
.symbar-wrap[data-open="0"] .symnav { display: none; }
.symbar-wrap[data-open="0"] .symbar-fold { color: var(--fg-dim); }

.sym {
  flex: 0 0 auto;
  min-width: 38px; height: 34px;
  border-radius: 8px; border: 1px solid var(--line);
  background: var(--bg-3); color: var(--fg);
  font-family: var(--mono); font-size: 14px; cursor: pointer;
  scroll-snap-align: start;
  touch-action: pan-x;          /* 允许横向滑动滚动，而不是被按钮吃掉 */
}
.sym:active { background: var(--accent); color: var(--accent-fg); }
.sym.wide { min-width: 58px; font-size: 12px; }
.symbar.grabbing { cursor: grabbing; }

/* ── 控制台 ── */
.console {
  flex: 0 0 auto;
  background: var(--bg-2);
  border-top: 1px solid var(--line);
  display: flex; flex-direction: column;
  height: 34vh; min-height: 120px;
  transition: height .2s;
  z-index: 15;
}
.console[data-open="false"] { height: 46px; min-height: 46px; }
.console[data-open="false"] .console-body,
.console[data-open="false"] .inputbar { display: none; }
.console-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 4px 8px; border-bottom: 1px solid var(--divider);
  flex: 0 0 auto;
}
.ptabs { display: flex; gap: 2px; }
.ptab {
  border: 0; background: transparent; color: var(--fg-faint);
  padding: 5px 9px; border-radius: 7px; font-size: 12px; cursor: pointer;
